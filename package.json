{
  "name": "n8n-nodes-sqlaccounting",
  "version": "1.2.2",
  "description": "n8n community node for the SQL Accounting REST API (Malaysia), via the SQL Accounting n8n Node subscription service.",
  "keywords": [
    "n8n-community-node-package",
    "sql-accounting",
    "malaysia",
    "accounting",
    "erp",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/laurentyew/n8n-nodes-sqlaccounting",
  "author": {
    "name": "laurentyew",
    "email": "laurentyew@gmail.com",
    "url": "https://github.com/laurentyew"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/laurentyew/n8n-nodes-sqlaccounting.git"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes/**/*.ts credentials/**/*.ts",
    "lintfix": "eslint nodes/**/*.ts credentials/**/*.ts --fix",
    "prepublishOnly": "npm run build && npm run lint && npm test",
    "test": "jest",
    "test:cov": "jest --coverage",
    "gen:registry": "node scripts/gen-registry.js",
    "contract:hash": "node scripts/contract-hash.js write",
    "mock-proxy": "ts-node scripts/run-mock-proxy.ts",
    "prebuild": "node scripts/gen-registry.js"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SqlAccountingApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SqlAccounting/SqlAccounting.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^18.16.16",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/laurentyew/n8n-nodes-sqlaccounting/issues"
  }
}
