{
  "contract_version": 1,
  "page_size": 50,
  "_rules": [
    "HTTP path is always '/' + resource (e.g. resource 'salesinvoice' -> /salesinvoice).",
    "path_param 'CODE' = string; 'DOCKEY' and 'AUTOKEY' = integer (validate before calling upstream).",
    "ops is either an array or the name of a set in ops_sets.",
    "verify_get / verify_endpoint = not confirmed in API doc. Spike S3 must confirm, then this flag is removed or the op removed.",
    "kind 'report' resources expose only op 'get' with no path_param; they accept query filters and offset pagination.",
    "This file is copied verbatim into the node repo and the backend repo. A test in each repo must fail if the copies differ."
  ],
  "ops_sets": {
    "crud": ["list", "get", "create", "update", "delete"],
    "read_delete": ["list", "get", "delete"],
    "report": ["get"]
  },
  "resources": [
    { "resource": "account",         "name": "Account",          "path_param": "CODE",    "ops": "crud", "kind": "master" },
    { "resource": "agent",           "name": "Agent",            "path_param": "CODE",    "ops": "crud", "kind": "master" },
    { "resource": "area",            "name": "Area",             "path_param": "CODE",    "ops": "crud", "kind": "master" },
    { "resource": "assetdisposal",   "name": "Asset Disposal",   "path_param": "AUTOKEY", "ops": "crud", "kind": "master" },
    { "resource": "assetgroup",      "name": "Asset Group",      "path_param": "AUTOKEY", "ops": "crud", "kind": "master" },
    { "resource": "assetitem",       "name": "Asset Item",       "path_param": "AUTOKEY", "ops": "crud", "kind": "master" },
    { "resource": "batch",           "name": "Stock Batch",      "path_param": "AUTOKEY", "ops": "crud", "kind": "master" },
    { "resource": "companycategory", "name": "Company Category", "path_param": "CODE",    "ops": "crud", "kind": "master", "verify_get": true },
    { "resource": "currency",        "name": "Currency",         "path_param": "CODE",    "ops": "crud", "kind": "master" },
    { "resource": "itemtemplate",    "name": "Item Template",    "path_param": "CODE",    "ops": "crud", "kind": "master" },
    { "resource": "location",        "name": "Location",         "path_param": "CODE",    "ops": "crud", "kind": "master" },
    { "resource": "memberpoint",     "name": "Member Point",     "path_param": "DOCKEY",  "ops": "crud", "kind": "master" },
    { "resource": "pmmethod",        "name": "Payment Method",   "path_param": "CODE",    "ops": "read_delete", "kind": "master" },
    { "resource": "pricetag",        "name": "Price Tag",        "path_param": "CODE",    "ops": "crud", "kind": "master" },
    { "resource": "project",         "name": "Project",          "path_param": "CODE",    "ops": "crud", "kind": "master" },
    { "resource": "shipper",         "name": "Shipper",          "path_param": "AUTOKEY", "ops": "crud", "kind": "master" },
    { "resource": "stockcategory",   "name": "Stock Category",   "path_param": "CODE",    "ops": "crud", "kind": "master", "verify_get": true },
    { "resource": "stockgroup",      "name": "Stock Group",      "path_param": "CODE",    "ops": "crud", "kind": "master", "verify_get": true },
    { "resource": "tariff",          "name": "Tariff",           "path_param": "AUTOKEY", "ops": "crud", "kind": "master", "verify_get": true },
